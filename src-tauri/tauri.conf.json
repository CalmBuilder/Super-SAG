{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super-SAG",
  "version": "0.1.0",
  "identifier": "com.sag.desktop",
  "build": {
    "beforeDevCommand": "npm run build:cli:dev && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:clipper:desktop && npm run build:cli && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Super-SAG",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "quick-search",
        "title": "Super-SAG — Quick Search",
        "url": "index.html?quick-search",
        "width": 900,
        "height": 520,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; worker-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/super-sag/32x32.png",
      "icons/super-sag/128x128.png",
      "icons/super-sag/128x128@2x.png",
      "icons/super-sag/icon.icns",
      "icons/super-sag/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": [
      "licenses/LUCIDE.txt",
      "licenses/TAURI-MIT.txt",
      "licenses/BITS-UI.txt",
      "licenses/SHADCN-SVELTE.txt",
      "licenses/MORPHDOM.txt",
      "licenses/GRAPH-VIEW.txt",
      "licenses/ANYDOC.txt",
      "bin/sag",
      "licenses/PELE.txt",
      "licenses/TEXTFOLD.txt",
      "clipper/"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
